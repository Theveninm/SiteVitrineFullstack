# Copie de référence des variables attendues par docker-compose.yml.
# Dans Portainer, ces valeurs se saisissent dans la section « Environment variables » de la stack
# (ou via « Advanced mode » en collant ce fichier) — pas besoin de déposer un .env sur le serveur.
# Ne JAMAIS committer le fichier .env réel.

# --- Base de données ---
POSTGRES_DB=sitevitrine
POSTGRES_USER=sitevitrine
# Mot de passe long et aléatoire. Génération : openssl rand -base64 32
POSTGRES_PASSWORD=change-moi

# --- Réseau ---
# Nom exact du réseau Docker de Nginx Proxy Manager (Portainer → Networks).
PROXY_NETWORK=nginx-proxy-manager_default
# Port de l'administration technique (Scalar, import/export) côté hôte, toujours publié sur
# 127.0.0.1. À changer si 8081 est déjà pris.
ADMIN_PORT=8081

# --- Back-office (page /admin du site, connexion avec Google) ---
# Client OAuth créé dans la console Google Cloud (cf. README, « Identifiants Google »).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comptes Google autorisés, séparés par des virgules.
ADMIN_EMAILS=
# Si l'une de ces trois valeurs est vide, toute connexion au back-office est refusée.

# --- Contenu ---
# Dossier contenant resources.yaml et images/, lus par l'import. En local : ./content. Sous Portainer : chemin ABSOLU de l'hôte
# (ex. /root/site-vitrine/content), cf. le commentaire du volume dans docker-compose.yml.
CONTENT_DIR=./content

# --- Images ---
# Tags des images construites. Utiles pour versionner : sitevitrine-api:2026-08-11
API_IMAGE=sitevitrine-api:latest
WEB_IMAGE=sitevitrine-web:latest
