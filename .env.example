# Copie de référence des variables attendues par docker-compose.yml.
# Dans Portainer, ces valeurs se saisissent dans la section « Environment variables » de la stack
# (ou via « Advanced mode » en collant ce fichier) — pas besoin de déposer un .env sur le serveur.
# Ne JAMAIS committer le fichier .env réel.

# --- Identité de la stack ---
# Préfixe des conteneurs et des tags d'images. À LAISSER VIDE pour la stack de production, et à
# renseigner (ex. sitevitrine-beta) pour faire tourner une préversion EN PARALLÈLE sur le même
# serveur — sans quoi la seconde stack entrerait en collision sur les noms de conteneurs et
# réécrirait les images de la première. Volumes et réseaux sont déjà cloisonnés par Compose,
# qui les préfixe du nom de la stack Portainer.
STACK_PREFIX=

# --- Base de données ---
POSTGRES_DB=sitevitrine
POSTGRES_USER=sitevitrine
# Mot de passe long et aléatoire. Génération : openssl rand -base64 32
POSTGRES_PASSWORD=change-moi

# --- Réseau ---
# Nom exact du réseau Docker de Nginx Proxy Manager (Portainer → Networks).
PROXY_NETWORK=nginx-proxy-manager_default
# Port de l'administration technique (Scalar, import/export) côté hôte, toujours publié sur
# 127.0.0.1. À changer si 8081 est déjà pris.
ADMIN_PORT=8081

# --- Back-office (page /admin du site, connexion avec Google) ---
# Client OAuth créé dans la console Google Cloud (cf. README, « Identifiants Google »).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comptes Google autorisés, séparés par des virgules.
ADMIN_EMAILS=
# Si l'une de ces trois valeurs est vide, toute connexion au back-office est refusée.

# --- Contenu ---
# Dossier contenant content.yaml et images/, lus par l'import. En local : ./content. Sous Portainer :
# chemin ABSOLU de l'hôte (ex. /root/site-vitrine/content), cf. le commentaire du volume dans
# docker-compose.yml. Deux stacks peuvent pointer le même dossier : il est monté en lecture seule.
CONTENT_DIR=./content

# --- Images ---
# À LAISSER VIDES dans le cas courant : les tags sont alors déduits de STACK_PREFIX
# (sitevitrine-api:latest, ou sitevitrine-beta-api:latest pour une préversion). Ne les renseigner
# que pour épingler une version (sitevitrine-api:2026-08-11) ou tirer d'un registre — et dans ce
# cas, donner des tags DISTINCTS à chaque stack.
API_IMAGE=
WEB_IMAGE=
